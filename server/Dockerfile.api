# The account API (src/api-main.ts) for Cloud Run. Built by deploy/gcp/build-image.sh with
# IMAGE=api, and deployed by deploy/gcp/deploy-api.sh. No dependencies: Node runs the
# TypeScript directly. The same image runs the stats jobs and the Ops dashboard (src/ops-main.ts,
# with its page in ops/).
FROM node:24-slim

WORKDIR /app
COPY package.json ./
COPY src ./src
COPY ops ./ops

ARG REVISION=unknown
ENV NODE_ENV=production \
    REVISION=$REVISION \
    STORE=firestore \
    PORT=8080

USER node
CMD ["node", "src/api-main.ts"]
