// Shared build settings for the spike. Put your own values in Local.xcconfig
// (copy Local.xcconfig.example); it is gitignored and overrides anything here.

PRODUCT_BUNDLE_IDENTIFIER = com.example.walkiespike
DEVELOPMENT_TEAM =

// Relay server host name, without a scheme (xcconfig treats "//" as a comment).
// The app connects with https:// and wss://.
SPIKE_SERVER_HOST =
SPIKE_TOKEN =

// How the watch learns it's being rung:
//   voip  VoIP push via PushKit. Needs a paid Apple Developer Program membership,
//         because free (Personal Team) signing can't include the push entitlement.
//   none  No push entitlement. The app polls the server for rings while it's open
//         and still rings through CallKit. Works with a free Personal Team.
SPIKE_PUSH_MODE = voip
SPIKE_ENTITLEMENTS_voip = Config/WalkieSpike.entitlements
SPIKE_ENTITLEMENTS_none = Config/WalkieSpike-NoPush.entitlements
CODE_SIGN_ENTITLEMENTS = $(SPIKE_ENTITLEMENTS_$(SPIKE_PUSH_MODE))

#include? "Local.xcconfig"
