<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Lets the simulator reach a server on this Mac over plain HTTP. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>SpikeServerHost</key>
	<string>$(SPIKE_SERVER_HOST)</string>
	<key>SpikeToken</key>
	<string>$(SPIKE_TOKEN)</string>
</dict>
</plist>
