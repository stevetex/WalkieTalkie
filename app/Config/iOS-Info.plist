<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Lets the simulator reach a server on this Mac over plain HTTP. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Over&amp;Out records your voice only while you hold the Talk button.</string>
	<key>OAOServerHost</key>
	<string>$(OAO_SERVER_HOST)</string>
	<key>UIBackgroundModes</key>
	<array>
		<!-- PushToTalk: its pushes wake the app, and it can talk from the Lock Screen. -->
		<string>push-to-talk</string>
	</array>
	<key>OAOApiHost</key>
	<string>$(OAO_API_HOST)</string>
	<key>OAOLinkDomain</key>
	<string>$(OAO_LINK_DOMAIN)</string>
</dict>
</plist>
