// Shared build settings for Nowza. Put your own values in Local.xcconfig (copy
// Local.xcconfig.example); it is gitignored and overrides anything here.

DEVELOPMENT_TEAM =

// The product's bundle ID (decided 2026-09-25; it can't change once the app ships).
// The watch app's is this plus ".watchkitapp". The watch registers for pushes itself,
// so the watch app's ID is the APNs topic for rings (the server's APNS_BUNDLE_ID).
OAO_BUNDLE_ID = com.cypressoakstudios.overandout

// Shared between the watch app and its notification service extension (the prefetch
// prototype: the extension downloads a ring's message there before the tap).
OAO_APP_GROUP = group.$(OAO_BUNDLE_ID)

// Relay server host name, without a scheme (xcconfig treats "//" as a comment).
OAO_SERVER_HOST = relay-1.nowza.app

// The account API (server/src/api.ts), at nowza.app/v1 through Firebase Hosting. For
// the simulator, a local relay run with SERVE_API=1 serves it too (OAO_API_HOST =
// localhost:8080). Plain host names: xcconfig treats "//" as a comment.
OAO_API_HOST = nowza.app
// Invite links (https://<domain>/i/<code>) open the iPhone app: its Associated Domains
// entitlement and the site's apple-app-site-association file (web/public).
OAO_LINK_DOMAIN = nowza.app

// Push on the watch and the iPhone:
//   yes  Push Notifications and Time Sensitive Notifications entitlements. Needs a
//        paid Apple Developer Program membership.
//   no   No push entitlements, so a free Personal Team can sign the app.
OAO_PUSH = yes
OAO_WATCH_ENTITLEMENTS_yes = Config/Watch.entitlements
OAO_WATCH_ENTITLEMENTS_no = Config/Watch-NoPush.entitlements
// The iPhone: with push, Push Notifications and Push to Talk (the iPhone rings through its
// PushToTalk channel; design decision 2026-09-27). Without, it talks only while on screen.
OAO_IOS_ENTITLEMENTS_yes = Config/iOS.entitlements
OAO_IOS_ENTITLEMENTS_no = Config/iOS-NoPush.entitlements

// Run builds compile only the assets the run destination needs, but the OverAndOutWatch scheme
// also builds the iPhone app for a watch destination, and actool can't thin an iPhone catalog
// for a watch model ("Could not get trait set for device Watch8,1"). So trim only when the
// target's platform is the destination's; the other target gets its full catalog.
OAO_ACTIVE_RESOURCES_iphoneos_iphoneos = YES
OAO_ACTIVE_RESOURCES_iphonesimulator_iphonesimulator = YES
OAO_ACTIVE_RESOURCES_watchos_watchos = YES
OAO_ACTIVE_RESOURCES_watchsimulator_watchsimulator = YES
ENABLE_ONLY_ACTIVE_RESOURCES = $(OAO_ACTIVE_RESOURCES_$(PLATFORM_NAME)_$(TARGET_DEVICE_PLATFORM_NAME))

#include? "Local.xcconfig"
