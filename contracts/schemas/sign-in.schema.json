{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sign-in.schema.json",
  "title": "POST /v2/auth/apple and /v2/auth/google (request)",
  "type": "object",
  "required": ["identityToken", "nonce", "deviceId", "clientKind"],
  "properties": {
    "identityToken": { "type": "string", "minLength": 1 },
    "nonce": { "type": "string" },
    "name": { "type": "string" },
    "deviceId": { "$ref": "common.schema.json#/$defs/id" },
    "clientKind": { "$ref": "common.schema.json#/$defs/clientKind" }
  }
}
